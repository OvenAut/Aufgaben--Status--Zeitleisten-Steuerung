<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-Desktop-App: WPF-Fenster mit WebView2. Die Web-Oberfläche aus public/ wird eingebettet,
       Anfragen an /api/... beantwortet BoardCore direkt im Prozess (kein Webserver, kein Port).
       Setzt die .NET 10 Desktop Runtime voraus (framework-abhängig, eine EXE). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ProjektStatusBoard</RootNamespace>
    <AssemblyName>Projekt-Status-Board</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoardCore\BoardCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- Web-Oberfläche: alle Dateien aus public/ unter "web/<Pfad>" einbetten -->
    <EmbeddedResource Include="..\..\public\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
